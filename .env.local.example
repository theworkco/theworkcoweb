# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used for admin writes if you build a publishing UI later.
# Never prefix this with NEXT_PUBLIC_, and only reference it in server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sanity CMS — provisioned automatically by the Vercel Marketplace integration
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_READ_TOKEN=your-read-token
SANITY_API_WRITE_TOKEN=your-write-token
